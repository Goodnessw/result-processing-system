{% extends "accounts/base.html" %}

{% block title %}Preview Excel Results{% endblock %}
{% block page_title %}Preview Excel Results{% endblock %}

{% block content %}
<style>
    .excel-preview {
        background: #fff;
        border: 1px solid #e5eaf2;
        border-radius: 15px;
        overflow: hidden;
        color: #172033;
    }

    .excel-preview-header {
        padding: 22px;
        background: linear-gradient(120deg, #fff, #f0f5ff);
        border-bottom: 1px solid #e5eaf2;
    }

    .excel-preview-header h2 {
        margin: 0 0 7px;
        font-size: 21px;
    }

    .excel-preview-header p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.7;
    }

    .excel-preview-table-wrap {
        overflow-x: auto;
    }

    .excel-preview table {
        width: 100%;
        min-width: 650px;
        border-collapse: collapse;
    }

    .excel-preview th,
    .excel-preview td {
        padding: 13px 16px;
        text-align: left;
        border-bottom: 1px solid #edf0f5;
        font-size: 13px;
    }

    .excel-preview th {
        background: #f8fafc;
        color: #64748b;
        text-transform: uppercase;
        font-size: 11px;
    }

    .excel-preview-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 20px;
        background: #fbfcfe;
    }

    .excel-preview-note {
        padding: 14px 20px;
        font-size: 13px;
        color: #475569;
        background: #f8fafc;
        border-bottom: 1px solid #e5eaf2;
    }

    @media (max-width: 650px) {
        .excel-preview-actions .result-btn {
            width: 100%;
            box-sizing: border-box;
        }
    }
</style>

<div class="excel-preview">
    <div class="excel-preview-header">
        <h2>Review imported results</h2>
        <p>
            {{ course.code }} — {{ course.title }}.
            Check the scores below before saving or submitting them.
        </p>
    </div>

    <div class="excel-preview-note">
        {{ total_students }} students validated successfully.
        CA is out of 30; Exam is out of 70.
        No results have been saved yet.
    </div>

    <div class="excel-preview-table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Matric Number</th>
                    <th>Student Name</th>
                    <th>CA / 30</th>
                    <th>Exam / 70</th>
                    <th>Total / 100</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                <tr>
                    <td>{{ row.matric_number }}</td>
                    <td>{{ row.student_name }}</td>
                    <td>{{ row.ca_score }}</td>
                    <td>{{ row.exam_score }}</td>
                    <td><strong>{{ row.total_score }}</strong></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <form method="post">
        {% csrf_token %}

        <div class="excel-preview-actions">
            <button
                type="submit"
                name="action"
                value="save"
                class="result-btn result-btn-primary"
            >
                Save All as Drafts
            </button>

            <button
                type="submit"
                name="action"
                value="submit"
                class="result-btn result-btn-submit"
                onclick="return confirm('Submit all imported results for approval?');"
            >
                Submit All for Approval
            </button>

            <a
                href="{% url 'course_results' course.id %}"
                class="result-btn result-btn-secondary"
            >
                Cancel Import
            </a>
        </div>
    </form>
</div>
{% endblock %}